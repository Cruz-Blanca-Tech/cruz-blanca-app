{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_next/static/*",
      "/favicon.ico",
      "*.{png,jpg,jpeg,gif,svg,ico,css,js,woff,woff2,ttf}"
    ]
  },
  "routes": [
    {
      "route": "/.swa/health",
      "allowedRoles": ["anonymous"]
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404",
      "statusCode": 404
    }
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
